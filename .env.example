# Use a strong, unique secret in production. Never commit real secrets.
SECRET_KEY=9F4aB2xK8vL1mP0wR7sT3zY6hN5jQ9dC
# PostgreSQL recommended for deployment. SQLite is used if DATABASE_URL is omitted.
DATABASE_URL=postgresql+psycopg://impact_user:change_me@localhost:5432/impact_db
# Admins must be provisioned from a trusted server shell: flask --app wsgi:app create-admin admin@example.com
APP_ENV=development
# For local HTTP testing use false. Production must use HTTPS and COOKIE_SECURE=true.
COOKIE_SECURE=false

# Password reset email (SMTP). Use an app password from your mail provider.
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_TIMEOUT=10
MAIL_USERNAME=your-smtp-user
MAIL_PASSWORD=your-smtp-app-password
# Only set this in the shell when running scripts/verify_smtp.py; use a test inbox.
SMTP_TEST_RECIPIENT=becr ihmn oqxx tvbc
MAIL_DEFAULT_SENDER=CampusRipple <no-reply@example.com>
PUBLIC_BASE_URL=https://your-campusripple-domain.example
# Production database monitoring/backup scripts use DATABASE_URL directly.
# Set APP_ENV=production to disable automatic create_all; apply migrations first.

# Enable only when a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# In production, email verification is required by default. Set false only for local demos.
REQUIRE_EMAIL_VERIFICATION=true
# Required production setting; application policy is fixed to this exact domain.
INSTITUTIONAL_EMAIL_DOMAINS=aceec.ac.in
# Configure only after ACE Engineering College approves the API contract and issues credentials.
COLLEGE_DATA_API_URL=
COLLEGE_DATA_API_TOKEN=
COLLEGE_DATA_API_TIMEOUT=15
# Fail closed on an empty API response unless the institution explicitly approves it.
COLLEGE_DATA_ALLOW_EMPTY_SYNC=false

# --- Vercel deployment ---
# Set these in Vercel > Project > Settings > Environment Variables (Production).
# Use a *pooled* PostgreSQL URL (Neon pooler / Supabase transaction pooler) as DATABASE_URL.
# Vercel sets VERCEL=1 automatically; APP_ENV must still be set to production.
# Run migrations from your machine or CI (not at runtime): flask --app wsgi:app db upgrade
